# Vercel Supabase Connect (or local) — publishable only, never service_role.
# Required when `.omd` has contentSource.ssot: supabase and you want remote content.
#
# Cursor Cloud: add these same key names as runtime secrets.
# `pnpm install` (env install) runs root postinstall → sync-env-local into
# apps/docs/.env.local. Manual: pnpm sync:env
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Legacy anon JWT also works:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# On-demand revalidate (ISR). Set the same secret on the docs deploy and in the
# agent/host environment that writes handbook rows, then POST /api/revalidate
# after content-port upserts:
#   Authorization: Bearer $OMD_REVALIDATE_SECRET
# Optional: OMD_DOCS_URL=https://your-docs.vercel.app
# OMD_REVALIDATE_SECRET=
# OMD_DOCS_URL=
