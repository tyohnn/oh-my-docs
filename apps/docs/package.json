{
  "name": "@oh-my-docs/docs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "node scripts/build-with-content.mjs",
    "start": "next start",
    "postinstall": "fumadocs-mdx",
    "prepare:content": "node scripts/prepare-content.mjs",
    "sync:env": "node scripts/sync-env-local.mjs",
    "pull:supabase": "node scripts/pull-supabase-content.mjs",
    "push:supabase": "node scripts/push-supabase-content.mjs",
